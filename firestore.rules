rules_version = '2';

// Règles Firestore du jeu de piste.
// ⚠️ Fichier versionné mais PAS déployé automatiquement : le publier depuis la
// console Firebase (Firestore → Règles) ou via l'API Firebase Rules après test.
//
// Modèle : UN SEUL compte e-mail + mot de passe, partagé par Lisa et Corentin.
// L'accès à l'écran admin est filtré par le code à 4 chiffres côté app ;
// ici, on garantit que seul ce compte accède aux données, et que le jeu
// ne peut pas être rempli en avance (une étape n'est écrivable qu'une fois ouverte).
// Le relais Apps Script écrit avec le compte de service : il passe outre ces règles.
// Fermé par défaut : tout ce qui n'est pas explicitement ouvert est refusé.

service cloud.firestore {
  match /databases/{database}/documents {

    function compte() { return request.auth != null && request.auth.uid == 'wg2JcW2kfkTGr1AB7ROEubZtL9h1'; }

    // Une étape n'existe dans Firestore qu'une fois débloquée (heure serveur du relais).
    function ouverte(n) { return exists(/databases/$(database)/documents/etapes/$(n)); }
    function numeroValide(n) { return n.matches('^([1-9]|1[0-9]|2[01])$'); }

    // ---------- etapes/{n} : état de déblocage ----------
    match /etapes/{n} {
      allow read: if compte();
      // Déblocage manuel de secours depuis l'admin (le relais fait le reste).
      allow create: if compte() && numeroValide(n)
        && request.resource.data.keys().hasOnly(['debloqueeA', 'mode'])
        && request.resource.data.mode == 'manuel'
        && request.resource.data.debloqueeA == request.time;
      allow delete: if compte();
      allow update: if false;
    }

    // ---------- progression/{n} : avancement de Lisa ----------
    match /progression/{n} {
      allow read: if compte();
      allow create, update: if compte() && numeroValide(n) && ouverte(n)
        && request.resource.data.keys().hasOnly(['questionOK', 'jeuOK', 'termineeA', 'tentatives', 'elimine'])
        && (!('questionOK' in request.resource.data) || request.resource.data.questionOK is bool)
        && (!('jeuOK' in request.resource.data) || request.resource.data.jeuOK is bool)
        && (!('tentatives' in request.resource.data) || (request.resource.data.tentatives is int && request.resource.data.tentatives < 10000))
        && (!('elimine' in request.resource.data) || (request.resource.data.elimine is string && request.resource.data.elimine.size() <= 20))
        && (!('termineeA' in request.resource.data) || request.resource.data.termineeA is timestamp);
      allow delete: if compte();
    }

    // ---------- reponses/{n} : réponses aux questions profondes ----------
    match /reponses/{n} {
      allow read: if compte();
      allow create, update: if compte() && numeroValide(n) && ouverte(n)
        && request.resource.data.keys().hasOnly(['texte', 'ecritA'])
        && request.resource.data.texte is string
        && request.resource.data.texte.size() > 0
        && request.resource.data.texte.size() <= 5000
        && request.resource.data.ecritA == request.time;
      allow delete: if compte();
    }

    // ---------- appareils/{id} : jeton push + rôle de chaque iPhone ----------
    match /appareils/{id} {
      allow read, delete: if compte();
      allow create, update: if compte()
        && id.size() >= 8 && id.size() <= 64
        && request.resource.data.keys().hasOnly(['jeton', 'role', 'majA', 'appareil'])
        && request.resource.data.jeton is string
        && request.resource.data.jeton.size() < 4096
        && request.resource.data.role in ['joueuse', 'admin']
        && request.resource.data.majA == request.time;
    }

    // ---------- journal/{id} : écrit uniquement par le relais ----------
    match /journal/{id} {
      allow read: if compte();
      allow write: if false;
    }

    // ---------- Tout le reste : refusé ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
